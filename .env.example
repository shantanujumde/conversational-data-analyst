PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/bank.db
AI_PROVIDER=google          # google | openai | mock (tests force mock)
AI_MODEL=                   # empty = provider default: gemini-4-hydrogen, gpt-5.4-mini
GEMINI_API_KEY=             # needed when AI_PROVIDER=google
OPENAI_API_KEY=             # needed when AI_PROVIDER=openai
ASK_RATE_LIMIT_PER_MINUTE=20 # questions per minute per IP on /api/v1/ask
LOG_LEVEL=info              # fatal | error | warn | info | debug | trace | silent
